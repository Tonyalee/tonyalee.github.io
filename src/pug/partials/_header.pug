header.header-work#menu.menu
    #goPrev.header-work__btn.header-work-btn.header-work-btn--left
      .header-work-btn__icon
        i(class="fa-solid fa-left-long")
      .header-work-btn__text Go Back
    .header-work__content.header-work-content
      .header-work-content__item.linkHome
        .header-work-content__text(val='ABOUT') ABOUT
      .header-work-content__item.linkUIUX
        .header-work-content__text(val='UI/UX') UI/UX
      .header-work-content__item.linkGame
        .header-work-content__text(val='GAME') GAME
      .header-work-content__item.linkData
        .header-work-content__text(val='DATA') DATA
      .header-work-content__item.linkTeam
        .header-work-content__text(val='TEAM') TEAM
      .header-work-content__item.linkBranding
        .header-work-content__text(val='BRANDING') BRANDING
    #goNext.header-work__btn.header-work-btn.header-work-btn--right
      .header-work-btn__text Go Next
      .header-work-btn__icon
        i(class="fa-solid fa-right-long")

#menuCloseBtn.menu__close-btn.menu-close-btn
  .menu-close-btn__btn(aria-label="Open Menu")
    svg(width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg")
      rect(y="4" width="24" height="2" fill="currentColor")
      rect(y="11" width="24" height="2" fill="currentColor")
      rect(y="18" width="24" height="2" fill="currentColor")